local RS = game:GetService("ReplicatedStorage")
local NetEvent = RS.Packages.Net:FindFirstChild("RE/9bb1cfbbed0f97d9eb0d2b59c674b7d3b2d2d9a2fcc9efafc3d9ec3ee55526cd")

-- Verificare existenta Remote
if not NetEvent then
    warn("Remote-ul nu a fost gasit! Probabil jocul s-a updatat.")
    return
end

local isGlitchActive = false
local ACCEPT_CODE = "\0\0\8B\0\0\8B"
local CANCEL_CODE = "\6\1\8B\6\1\8B"

-- Functia principala de Spam / Freeze
local function RunTradeGlitch()
    task.spawn(function()
        while isGlitchActive do
            -- Trimitem rafale de pachete contradictorii
            for i = 1, 25 do
                NetEvent:FireServer(ACCEPT_CODE)
                NetEvent:FireServer(CANCEL_CODE)
            end
            -- Timp de asteptare optim pentru a evita Kick-ul (0.08 - 0.1)
            task.wait(0.08)
        end
    end)
end

