-- Blox Fruits Freeze Trade - Risky Version
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local TradeRemote = RS:WaitForChild("Remotes"):WaitForChild("TradeFunction")

-- Creare GUI
local ScreenGui = Instance.new("ScreenGui")
local parent = nil
pcall(function() parent = game:GetService("CoreGui") end)
if not parent then parent = LP:WaitForChild("PlayerGui") end
ScreenGui.Parent = parent

local Frame = Instance.new("Frame")
Frame.Parent = ScreenGui
Frame.Size = UDim2.new(0, 250, 0, 150)
Frame.Position = UDim2.new(0.5, -125, 0.5, -75)
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Frame.Active = true
Frame.Draggable = true

local Title = Instance.new("TextLabel")
Title.Parent = Frame
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "FREEZE BYPASS TEST"
Title.TextColor3 = Color3.fromRGB(255, 50, 50)
Title.BackgroundTransparency = 1

local FreezeBtn = Instance.new("TextButton")
FreezeBtn.Parent = Frame
FreezeBtn.Size = UDim2.new(0, 180, 0, 45)
FreezeBtn.Position = UDim2.new(0.15, 0, 0.4, 0)
FreezeBtn.Text = "START FREEZE (OFF)"
FreezeBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
FreezeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

local isFreezeOn = false

-- Logica de Spam/Freeze
local function StartFreeze()
    task.spawn(function()
        while isFreezeOn do
            -- Trimite 15 cereri rapide pe secunda
            for i = 1, 15 do
                task.spawn(function()
                    -- pcall previne crash-ul scriptului daca serverul refuza cererea
                    pcall(function()
                        TradeRemote:InvokeServer("accept")
                    end)
                end)
            end
            task.wait(0.1) -- Delay critic pentru a nu bloca procesorul tau
        end
    end)
end

FreezeBtn.MouseButton1Click:Connect(function()
    isFreezeOn = not isFreezeOn
    if isFreezeOn then
        FreezeBtn.Text = "FREEZE RUNNING..."
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
        StartFreeze()
    else
        FreezeBtn.Text = "START FREEZE (OFF)"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
    end
end)

-- Buton Inchidere
local Close = Instance.new("TextButton")
Close.Parent = Frame
Close.Size = UDim2.new(0, 25, 0, 25)
Close.Position = UDim2.new(0.88, 0, 0.05, 0)
Close.Text = "X"
Close.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
Close.MouseButton1Click:Connect(function() 
    isFreezeOn = false
    ScreenGui:Destroy() 
end)
