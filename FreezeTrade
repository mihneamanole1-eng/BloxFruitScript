--[[ 
    STEAL A BRAINROT: ULTRA-COMPATIBLE FREEZE
    Daca nu apare butonul, verifica consola de erori (F9 sau /console)
]]

local player = game.Players.LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local NetEvent = RS.Packages.Net:FindFirstChild("RE/9bb1cfbbed0f97d9eb0d2b59c674b7d3b2d2d9a2fcc9efafc3d9ec3ee55526cd")

-- Creăm GUI direct în PlayerGui (mai sigur pentru Mobile)
local sg = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
sg.ResetOnSpawn = false
sg.Name = "BrainrotHack"

local btn = Instance.new("TextButton", sg)
btn.Size = UDim2.new(0, 160, 0, 45)
btn.Position = UDim2.new(0.5, -80, 0.1, 0)
btn.Text = "FREEZE: OFF"
btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
btn.TextColor3 = Color3.new(1, 1, 1)
btn.ZIndex = 999 -- Sa fie deasupra tuturor meniurilor

local isFreezing = false
local ACCEPT_CODE = "\0\0\8B\0\0\8B"
local CANCEL_CODE = "\6\1\8B\6\1\8B"

btn.MouseButton1Click:Connect(function()
    if not NetEvent then
        btn.Text = "ERROR: NO REMOTE"
        return
    end

    isFreezing = not isFreezing
    if isFreezing then
        btn.Text = "FREEZE: ACTIVE"
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        
        task.spawn(function()
            while isFreezing do
                for i = 1, 15 do
                    NetEvent:FireServer(ACCEPT_CODE)
                    NetEvent:FireServer(CANCEL_CODE)
                end
                task.wait(0.1)
            end
        end)
    else
        btn.Text = "FREEZE: OFF"
        btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    end
end)

print("Script incarcat! Daca nu vezi butonul, scrie /console in chat.")
