local function TQLFG_fake_script() -- Frame.LocalScript 
	local script = Instance.new('LocalScript', Frame)

	-- LocalScript sa loob ng ScreenGui o Frame
	
	local freezeBtn = script.Parent:WaitForChild("FreezeTradeBtn")
	local autoBtn = script.Parent:WaitForChild("AutoAcceptBtn")
	
	local isFreezeOn = false
	local isAutoOn = false
	
	freezeBtn.MouseButton1Click:Connect(function()
		isFreezeOn = not isFreezeOn
		if isFreezeOn then
			freezeBtn.Text = "FREEZE TRADE (ON)"
			freezeBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
		else
			freezeBtn.Text = "FREEZE TRADE (OFF)"
			freezeBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
		end
	end)
	
	autoBtn.MouseButton1Click:Connect(function()
		isAutoOn = not isAutoOn
		if isAutoOn then
			autoBtn.Text = "AUTO ACCEPT (ON)"
			autoBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
		else
			autoBtn.Text = "AUTO ACCEPT (OFF)"
			autoBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
		end
	end)
	print("Hello world!")
	
end
coroutine.wrap(TQLFG_fake_script)()
